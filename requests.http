@baseUrl = http://localhost:3000

### Реєстрація користувача
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "driver@test.com",
  "password": "123456"
}

### Авторизація користувача
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "driver@test.com",
  "password": "123456"
}

